  "queries": {
    "repliesOf": {
      "sql": "SELECT id, sequence, body FROM events\n       WHERE room_id=? AND sequence>? AND sequence<=? AND json_extract(body,'$.type')='message.posted'\n         AND json_extract(body,'$.data.replyToId') IS NOT NULL\n       ORDER BY sequence ASC LIMIT ?",
      "sha256": "a99f73eaccae5bd47e0b547e4f288c57cd049fc3b5b9e16b756e6808af42a6aa"
    },
    "mentionHorizon": {
      "sql": "SELECT e.sequence, e.id AS eventId, e.body, m.state AS state, m.timeout_at AS timeoutAt,\n              o.acknowledged_at AS acknowledgedAt, o.late_acknowledged_at AS lateAcknowledgedAt\n       FROM mention_states m\n       JOIN events e ON e.room_id=m.room_id AND e.id=m.message_event_id\n       LEFT JOIN mention_observations o ON o.room_id=m.room_id AND o.message_event_id=m.message_event_id\n         AND o.mentioned_member_id=m.mentioned_member_id\n       WHERE m.room_id=? AND m.mentioned_member_id=? AND e.sequence>? AND e.sequence<=?\n         AND m.state IN ('delivered','acknowledged','timed_out')\n       ORDER BY e.sequence ASC LIMIT ?",
      "sha256": "be3924022c0724c28526963917dce1f096435776296069d99462b054208ee8c7"
    }
  },
  "sourceSha256": {
    "server/needs-me.mjs": "c356f855609ee669a33103ccc45ea1e211e3543572af2fef275f825ed8b91a83",
    "server/store.mjs": "29cd30753d75e3100c52171a20ff8971b0a3280732437e6807854c9803350bdb",
